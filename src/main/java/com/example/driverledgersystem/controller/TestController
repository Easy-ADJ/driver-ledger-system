package com.example.driverledgersystem.controller;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.client.RestClient;

@RestController
public class TestController
{
    private final RestClient paymentRestClient;

    // 생성자 주입
    public TestController(RestClient paymentRestClient)
    {
        this.paymentRestClient = paymentRestClient;
    }

    @GetMapping("/api/test/ping-payment")
    public String pingPaymentServer()
    {
        // 1번 기사 데이터 고정 호출
        return paymentRestClient.get()
                .uri("/api/ledger?driver_id=1")
                .retrieve()
                .body(String.class);
    }
}